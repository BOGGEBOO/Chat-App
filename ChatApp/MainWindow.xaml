<Window x:Class="ChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatApp"
        mc:Ignorable="d"
        Title="Message Sender" Height="450" Width="800">
    <Grid>
        <TextBlock Text="Welcome" FontSize="25" Margin="340,31,340,367"></TextBlock>
        <TextBlock Text="Enter your name:" Margin="218,86,457,323"></TextBlock>
        <TextBox Margin="218,116,218,287" Text="{Binding UserName}"></TextBox>
        <TextBlock Text="Enter your portnumber:" Margin="218,169,457,238"></TextBlock>
        <TextBox Margin="218,201,218,202" Text="{Binding PortNumber}"/>
        <TextBlock Text="Enter your IP-address:" Margin="218,256,457,152"></TextBlock>
        <TextBox Margin="218,282,218,121" Text="{Binding IpAddress}"/>
        <Button Content="Start Server" Margin="248,334,248,74" Command="{Binding StartServer}" />
        <Button Content="Start Client" Margin="248,379,248,29" Command="{Binding StartClient}"/>
    </Grid>
</Window>
