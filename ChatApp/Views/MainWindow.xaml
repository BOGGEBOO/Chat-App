<Window x:Class="ChatApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatApp.Views"
 
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        
        <Storyboard x:Key="sb" TargetProperty="Left" Name="Shaker">
            <DoubleAnimation From="500" To="515" Duration="0:0:0.05"
                                     AutoReverse="True" RepeatBehavior="3x"
                                     FillBehavior="Stop"/>
        </Storyboard>
        
    </Window.Resources>
    
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <StackPanel VerticalAlignment="Top" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
            <TextBlock Text="{Binding ValidationMessage}" Foreground="Red" />
            <TextBlock Text="Enter your name:" Margin="3,0,0,2"  FontSize="10"/>
            <TextBox Text="{Binding UserName}" Height="15" Width="150" HorizontalAlignment="Left" Margin="3, 0, 0, 0" FontSize="10"/>
            <TextBlock Text="Enter your portnumber:" Margin="0,5,0,5" FontSize="10"/>
            <TextBox Text="{Binding PortNumber}" Height="15" Width="150" HorizontalAlignment="Left" Margin="3, 0, 0, 0" FontSize="10"/>
            <TextBlock Text="Enter your IP-address:" Margin="0,5,0,5" FontSize="10"/>
            <TextBox Text="{Binding IpAddress}" Height="15" Width="150" HorizontalAlignment="Left" Margin="3, 0, 0, 5" FontSize="10"/>
            <Button Content="Start Listening" Command="{Binding StartServer}" Width="100" FontSize="10" HorizontalAlignment="Left" Margin="3, 0, 0, 5" IsEnabled="{Binding SignedOut}"/>
            <Button Content="Request Connection" Command="{Binding StartClient}" Width="100" FontSize="10" HorizontalAlignment="Left" Margin="3, 0, 0, 5" IsEnabled="{Binding SignedOut}"/>
            <Button Content="Disconnect" Command="{Binding Disconnect}" Width="100" FontSize="10" HorizontalAlignment="Left" Margin="3, 0, 0, 5" IsEnabled="{Binding ActiveConnection}"/>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="2" Grid.RowSpan="2">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBox Text="{Binding SearchString}" Grid.Row="0" Grid.Column="0" Width="120"/>
                <Button Content="Search" Command="{Binding Search}" Width="100" Grid.Row="0"  Grid.Column="1"/>
            </Grid>
            <ListBox Name="ContactList" SelectedItem="{Binding SelectedProperty}" Height="165"  SelectionMode="Single" ItemsSource="{Binding ShownContacts}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="Name" />
                                    <Binding Path="LastActive" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"  Grid.RowSpan="3" Margin="10" Name="Root">
            <TextBlock Text="Chat" Margin="10" FontSize="10"/>
            <ScrollViewer Height="300" VerticalScrollBarVisibility="Visible" x:Name="Scrollan" >
                <Grid>
                    <ItemsControl ItemsSource="{Binding Conversation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,10,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{1}: {0} &#x0a;{2}&#x0a;">
                                            <Binding Path="Sender" />
                                            <Binding Path="Date" />
                                            <Binding Path="Content" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

        </StackPanel>
        <DockPanel Grid.Row="3" Grid.Column="1">
            <TextBox Height="30" Text="{Binding NewMessage, Mode=TwoWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="3" Grid.Column="2" Margin="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="Send" Command="{Binding SendMessage}" VerticalAlignment="Center" IsEnabled="{Binding ActiveConnection}"/>
            <Button Grid.Row="1" Content="Buzz" Command="{Binding SendBuzz}"  VerticalAlignment="Center" IsEnabled="{Binding ActiveConnection}"/>
            </Grid>
        </DockPanel>

    </Grid>
</Window>
