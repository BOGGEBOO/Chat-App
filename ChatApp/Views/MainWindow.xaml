<Window x:Class="ChatApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatApp.Views"
        mc:Ignorable="d"
        Title="Message Sender" Height="490" Width="800">
    <Grid>
        
        <StackPanel Width="500" VerticalAlignment="Center">
            <TextBlock Text="Welcome" FontSize="25"></TextBlock>
            <TextBlock Text="Enter your name:" Margin="0,10,0,10"></TextBlock>
            <TextBox Text="{Binding UserName}"></TextBox>
            <TextBlock Text="Enter your portnumber:" Margin="0,10,0,10"></TextBlock>
            <TextBox Text="{Binding PortNumber}"/>
            <TextBlock Text="Enter your IP-address:" Margin="0,10,0,10"></TextBlock>
            <TextBox Text="{Binding IpAddress}"/>
            <Button Content="Start Server" Command="{Binding StartServer}" Margin="0,10,0,10"/>
            <Button Content="Start Client" Command="{Binding StartClient}"/>
        </StackPanel>
    </Grid>
</Window>
